      <ee:message />
      <ee:variables>
        <ee:set-variable
          variableName="zip">
          <![CDATA[%dw 2.0
output application/java

var timestamp = (
    now() as DateTime >> "America/Sao_Paulo"
) as String { format: "uuuuMMddHHmmss"} 
---
modules::app::cFileWorkingDirectory ++
(
	attributes.queryParams.'zip'
	default "out/example_$(timestamp).zip"
) as String
//modules::app::cFileWorkingDirectory ++ "/in/example.zip"
]]></ee:set-variable>
      </ee:variables>
    </ee:transform>
    <choice
      doc:name="Choice"
      doc:id="49fd274d-848c-45b2-bec7-a519d8bb9e0a">
      <when
        expression="#['progress' == attributes.queryParams.'route']">
        <logger
          level="INFO"
          doc:name="Logger"
          doc:id="7f6bb20b-ef5d-4f47-be89-82493195adca" />
      </when>
      <otherwise>
        <ee:transform
          doc:name="Set payload /java - Args for Java Class"
          doc:id="05cdae77-305c-4398-a465-65976748cd73">
          <ee:message>
            <ee:set-payload>
              <![CDATA[%dw 2.0
output application/java

var files = (
	attributes.queryParams.'files' splitBy  ","
	default [ "in/data_example_01.csv", "in/data_example_02.csv" ]
) as Array map ((item, index) -> 
	modules::app::cFileWorkingDirectory ++ item
)

---
{
	zipPath: vars.zip, // destZipFile
	files: files // files
}

]]></ee:set-payload>
          </ee:message>
        </ee:transform>
        <java:invoke-static
          doc:name="Invoke static ZipUtility.addFiles(String zipFile, String[] files)"
