            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import * from dw::Runtime

output application/json skipNullOn="everywhere"
---
{
	app: {
		env: Mule::p('env'),
		name: Mule::p('api.name'),
		version: Mule::p('api.version'),
		id: Mule::p('api.id')
	},
	system: {
		name: Mule::p('os.name'),
		version: Mule::p('os.version'),
		arch: Mule::p('os.arch'),
		//availableCoreProcessors: Java::invoke('Runtime', 'getRuntime().availableProcessors()', vars.availableCoreProcessors, {})
	},
	memory: {
		total: null //Java::invoke('Runtime.getRuntime()', 'totalMemory()', vars.temp, {})
	},
	props: props()
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
