    <flow name="api-zip-main" doc:id="97c58b3e-387b-4183-9f8a-6336b5aa6d05">
        <http:listener config-ref="api-zip-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[modules::xCorrelationId::set(vars.outboundHeaders,correlationId)]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[modules::xCorrelationId::set(vars.outboundHeaders,correlationId)]]]></http:headers>
            </http:error-response>
        </http:listener>
        <!--  -->
        <apikit:router config-ref="api-zip-config" doc:name="api-zip-config" />
        <!--  -->
    </flow>
    <!--  -->
    <!--  -->
    <!--  -->
    <flow name="api-zip-console">
        <http:listener config-ref="api-zip-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[modules::xCorrelationId::set(vars.outboundHeaders,correlationId)]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[modules::xCorrelationId::set(vars.outboundHeaders,correlationId)]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="api-zip-config" doc:name="api-zip-config" />
    </flow>
