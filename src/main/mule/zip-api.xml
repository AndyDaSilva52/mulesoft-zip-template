<?xml version="1.0" encoding="UTF-8"?>
<mule
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
	http://www.mulesoft.org/schema/mule/core 
	http://www.mulesoft.org/schema/mule/core/current/mule.xsd 
	http://www.mulesoft.org/schema/mule/http 
	http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
	http://www.mulesoft.org/schema/mule/mule-apikit 
	http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
	http://www.mulesoft.org/schema/mule/ee/core 
	http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">

	<flow name="zip-api-main">
		<http:listener
			config-ref="zip-api-httpListenerConfig"
			path="/api/*">
			<http:response statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:router config-ref="zip-api-config" />
		<error-handler ref="zip-api-error-global">

		</error-handler>
	</flow>

	<flow name="zip-api-console">
		<http:listener
			config-ref="zip-api-httpListenerConfig"
			path="/console/*">
			<http:response statusCode="#[vars.httpStatus default 200]">
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:response>
			<http:error-response statusCode="#[vars.httpStatus default 500]">
				<http:body>#[payload]</http:body>
				<http:headers>#[vars.outboundHeaders default {}]</http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console config-ref="zip-api-config" />
		<error-handler ref="zip-api-error-global">

		</error-handler>
	</flow>

	<flow name="get:\status:zip-api-config">
		<logger
			level="INFO"
			message="get:\status:zip-api-config" />
	</flow>

	<flow name="get:\zip\compress:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\compress:zip-api-config" />
	</flow>

	<flow name="get:\zip\decompress:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\decompress:zip-api-config" />
	</flow>

	<flow name="get:\zip\archive:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\archive:zip-api-config" />
	</flow>

	<flow name="get:\zip\extract:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\extract:zip-api-config" />
	</flow>

	<flow name="get:\zip\zip:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\zip:zip-api-config" />
	</flow>

	<flow name="get:\zip\unzip:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\unzip:zip-api-config" />
	</flow>

	<flow name="get:\zip\append-to-zip:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\append-to-zip:zip-api-config" />
	</flow>

	<flow name="get:\zip\entries-from-zip:zip-api-config">
		<logger
			level="INFO"
			message="get:\zip\entries-from-zip:zip-api-config" />
	</flow>

</mule>
