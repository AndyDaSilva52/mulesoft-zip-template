#%RAML 1.0 Library

traits:
  header-x-correlation-id: !include ./traits/header-correlation-id.raml
  
  query-params-path:
    queryParameters:
      path:
        type: string
        required: false
        examples:
          "Relative Folder `in`": "in"
          "Relative Folder `out`": "out"
          #"Absolute"
  
          
  query-params-file-match:
    queryParameters:
      match: !include ./traits/file-match.raml
  
  query-params-recursive:
    queryParameters:
      recursive:
        type: boolean
        required: false
        examples:
          "True": true
          "False": false
          #"Absolute"
  
  query-params-zip:
    queryParameters:
      zip:
        type: string
        #displayName:
        required: true
        examples:
          "Example": "example.zip" 
  
  query-params-name:
    queryParameters:
      name:
        type: string
        required: false
        examples:
          "Example": "example.zip"
  
  query-params-files:
    queryParameters:
      files:
        type: array
        items:
          type: string
          #examples:
          #  "Example": 
          #    - "data_example_01.csv"
          #    - "data_example_02.csv"
  
  responses-200-OK: !include ./traits/responses/200-OK.raml
  
