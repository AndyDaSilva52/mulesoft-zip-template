#%RAML 1.0 Trait
    responses:
      200:
        description: |
          200 OK
        body:
          application/json:
            type: <<typeResponse200>>
            examples: <<examplesResponse200>>
        headers: 
          x-correlation-id:
            required: false
            type: string
            description: Unique value to track end to end transaction
            example: "ec0c8b70-49a5-11ed-8288-02a9c35111b8"
