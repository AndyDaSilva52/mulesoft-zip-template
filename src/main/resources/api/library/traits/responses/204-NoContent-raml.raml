#%RAML 1.0 Trait
    responses:
      204:
        description: |
          204 No Content
        body: 
          application/json:
            type: nil
        headers: 
          x-correlation-id:
            required: false
            type: string
            description: Unique value to track end to end transaction
            example: "ec0c8b70-49a5-11ed-8288-02a9c35111b8"