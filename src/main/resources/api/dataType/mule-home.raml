#%RAML 1.0 DataType 

type: array
items:
  type: object
  properties:
    lastModifiedTime:
      type: datetime
      example: '2023-01-18T22:16:43.0722Z'
      required: false
    lastAccessTime:
      type: datetime
      example: '2023-01-18T22:16:43.0722Z'
      required: false
    creationTime:
      type: datetime
      example: '2023-01-18T22:11:16.980Z'
      required: false
    symbolicLink:
      type: boolean
      example: false
      required: false
    regularFile:
      type: boolean
      example: true
      required: false
    directory:
      type: boolean
      example: false
      required: false
    path:
      type: string
      example: >-
        \opt\mule\apps\zip-template\data\in\data.csv
      required: false
    size:
      type: integer
      example: 282
      required: false
    name:
      type: string
      example: data.csv
      required: false
